---
source: bin/router/src/query_planner/tests/context.rs
expression: plan.to_string()
---
QueryPlan {
  Sequence {
    Fetch(service: "a") {
      {
        viewer {
          __typename
          ... on User {
            __typename
            currency
            txs {
              ...a
            }
          }
          ... on Other {
            __typename
            currency
            txs {
              ...a
            }
          }
        }
      }
      fragment a on Transaction {
        __typename
        id
      }
    },
    BatchFetch(service: "a") {
      {
        _e0 {
          paths: [
            "viewer|[Other].txs.@"
          ]
          {
            ... on Transaction {
              __typename
              id
            }
          }
        }
        _e1 {
          paths: [
            "viewer|[User].txs.@"
          ]
          {
            ... on Transaction {
              __typename
              id
            }
          }
        }
      }
      ($__context_1:String,$__context_0:String) {
        _e0: _entities(representations: $__batch_reps_0) {
          ... on Transaction {
            fromUnion(code: $__context_1)
          }
        }
        _e1: _entities(representations: $__batch_reps_1) {
          ... on Transaction {
            fromUnion(code: $__context_0)
          }
        }
      }
    },
  },
},
