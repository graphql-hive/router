---
source: bin/router/src/query_planner/tests/context.rs
expression: plan.to_string()
---
QueryPlan {
  Sequence {
    Fetch(service: "a") {
      {
        users {
          __typename
          currency
          txs {
            __typename
            id
          }
        }
      }
    },
    Skip(if: $skip) {
      Flatten(path: "users.@.txs.@") {
        Fetch(service: "a") {
          {
            ... on Transaction {
              __typename
              id
            }
          } =>
          ($__context_0:String) {
            ... on Transaction {
              amount(code: $__context_0)
            }
          }
        },
      },
    },
  },
},
