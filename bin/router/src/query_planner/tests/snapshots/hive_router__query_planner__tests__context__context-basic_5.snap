---
source: bin/router/src/query_planner/tests/context.rs
expression: plan.to_string()
---
QueryPlan {
  Sequence {
    Fetch(service: "a") {
      {
        outer {
          __typename
          code
          user {
            __typename
            currency
            txs {
              __typename
              id
            }
          }
        }
      }
    },
    Flatten(path: "outer.user.txs.@") {
      Fetch(service: "a") {
        {
          ... on Transaction {
            __typename
            id
          }
        } =>
        ($__context_0:String,$__context_1:String) {
          ... on Transaction {
            multiple(code: $__context_0, outer: $__context_1)
          }
        }
      },
    },
  },
},
